{
  "name": "curriculum-vitae",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check:": "oxfmt --check"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@lucide/vue": "^1.42.0",
    "modern-normalize": "^3.0.1",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "lint-staged": "^17.5.1",
    "npm-run-all2": "^9.0.2",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "sass-embedded": "^1.103.1",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vite-svg-loader": "^5.1.3",
    "vue-tsc": "^3.3.7"
  },
  "lint-staged": {
    "*.ts": "npm run lint",
    "*": "npm run fmt"
  },
  "engines": {
    "node": ">=26.8.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
}
